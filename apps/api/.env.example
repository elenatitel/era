NODE_ENV=development
PORT=4000
APP_NAME=HotelPMS
WEB_ORIGIN=http://localhost:3000

# Runtime role (no superuser, no BYPASSRLS) and owner role used for migrations
DATABASE_URL=postgres://pms_app:pms_app@127.0.0.1:5432/pms
DATABASE_MIGRATION_URL=postgres://pms_owner:pms_owner@127.0.0.1:5432/pms

# openssl rand -hex 32
JWT_SECRET=
# openssl rand -base64 32
ENCRYPTION_KEY=

# Leave SMTP_HOST empty in development: e-mails (invitations, resets) are printed to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="HotelPMS <no-reply@example.com>"

PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=
