# Public domain served by Caddy (DNS A/AAAA record must point to this server)
DOMAIN=pms.example.com
APP_NAME=era.

# Generate each with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -base64 32
ENCRYPTION_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="era. <no-reply@example.com>"

# First platform administrator (created by `npm run db:seed`, must enable 2FA at first sign-in)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
