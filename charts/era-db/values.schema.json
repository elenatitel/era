{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "existingSecret", "appUser", "persistence"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "existingSecret": {"type": "string", "minLength": 1},
    "appUser": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
    "persistence": {
      "type": "object",
      "required": ["size", "storageClass", "local"],
      "properties": {
        "size": {"type": "string"},
        "storageClass": {"type": "string", "minLength": 1},
        "local": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "node": {"type": "string"},
            "path": {"type": "string"}
          }
        }
      }
    }
  }
}
