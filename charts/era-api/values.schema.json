{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "image",
    "existingSecret",
    "database",
    "app",
    "auth"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "replicas": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "app": {
      "type": "object",
      "required": [
        "webOrigin"
      ],
      "properties": {
        "webOrigin": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "mailpit": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "digest"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "issuer",
        "clientId",
        "existingSecret"
      ],
      "properties": {
        "provider": {
          "enum": [
            "local",
            "keycloak"
          ]
        },
        "issuer": {
          "type": "string",
          "pattern": "^https://[^ /]+/realms/[^ /]+$"
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "doorkey": {
      "type": "object",
      "required": [
        "enabled",
        "managerUrl",
        "existingSecret"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "managerUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
