{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "apiService", "apiPort", "route", "auth"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "route": {
      "type": "object",
      "required": ["enabled", "hostname", "gatewayName", "gatewayNamespace"],
      "properties": {
        "hostname": {"type": "string", "minLength": 1},
        "gatewayName": {"type": "string", "minLength": 1},
        "gatewayNamespace": {"type": "string", "minLength": 1},
        "sectionName": {"type": "string"}
      }
    },
    "auth": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}, "existingSecret": {"type": "string"}}
    }
  }
}
